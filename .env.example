# Copy to .env and fill in ONE of the two API keys below.

# Option A — Claude (the default): key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Option B — OpenRouter: key from https://openrouter.ai/keys
# If only this key is set, the app uses OpenRouter automatically.
OPENROUTER_API_KEY=
# A model that can read images. Browse https://openrouter.ai/models and
# filter by image input; ids ending in ":free" cost nothing but are rate-limited.
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_MAX_TOKENS=16000

# Force a provider when both keys are set: anthropic | openrouter
# AI_PROVIDER=

# Optional: require this passcode before the app will call the AI.
# Set it whenever the server is reachable from the internet.
APP_PASSCODE=

# Optional Claude tuning (defaults shown).
# ANTHROPIC_MODEL=claude-opus-5-5
# TRANSCRIBE_EFFORT=medium   # low | medium | high | xhigh | max
# ANALYZE_EFFORT=medium
# PORT=3000

# Serve the bundled sample instead of calling any AI (for trying the UI).
# MOCK_CLAUDE=1
