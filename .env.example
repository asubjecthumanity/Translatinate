# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.

# Your Claude API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: require this passcode before the app will call Claude.
# Set it whenever the server is reachable from the internet.
APP_PASSCODE=

# Optional tuning (defaults shown).
# ANTHROPIC_MODEL=claude-opus-5-5
# TRANSCRIBE_EFFORT=medium   # low | medium | high | xhigh | max
# ANALYZE_EFFORT=medium
# PORT=3000

# Serve the bundled sample instead of calling Claude (for trying the UI).
# MOCK_CLAUDE=1
